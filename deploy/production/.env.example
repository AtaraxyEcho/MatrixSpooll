# MatrixSpooll 生产环境配置（PostgreSQL）
# 复制为 .env 后填入你的值

# ============================================================
# 认证配置 (Authentication)
# ============================================================
# 登录用户名（默认: admin）
AUTH_USERNAME=admin
# 登录密码（生产环境必填，不支持自动生成）
AUTH_PASSWORD=
# JWT 签名密钥（生产环境必填；HttpOnly 只保护 Cookie 读取，仍需该密钥防止 JWT 被伪造）
# 建议使用 openssl rand -hex 32 生成。
AUTH_TOKEN_SECRET=

# ============================================================
# Nginx / Certbot 公网入口
# ============================================================
# 只填写不带协议、端口和路径的公网域名或 IPv4 地址。
# 域名证书使用常规有效期；IPv4 证书使用 Let’s Encrypt shortlived 配置，
# 有效期约 6 天，由 Certbot 容器自动续期。
PUBLIC_HOST=video.example.com
# 浏览器实际访问的 origin，必须与 PUBLIC_HOST 对应且不要带末尾斜杠。
PUBLIC_ORIGIN=https://video.example.com
# Certbot 续期失败时用于接收通知的邮箱（必填）。
CERTBOT_EMAIL=admin@example.com

# 供应商凭证静态加密密钥（Fernet 格式，可选）。留空时自动生成到
# projects/.credential-key；部署备份与迁移必须保留该文件，否则已有凭证无法解密。
# MATRIXSPOOLL_CREDENTIAL_KEY=

# 项目媒体磁盘安全余量（GiB），生成入队、上传和 readiness 共用；默认 2，设 0 关闭。
# MATRIXSPOOLL_MIN_FREE_GB=2

# 项目归档导入安全上限。除条目数和压缩比外均为字节，通常保持默认值。
# MATRIXSPOOLL_IMPORT_MAX_UPLOAD_BYTES=8589934592
# MATRIXSPOOLL_IMPORT_MAX_MEMBERS=10000
# MATRIXSPOOLL_IMPORT_MAX_MEMBER_BYTES=8589934592
# MATRIXSPOOLL_IMPORT_MAX_TOTAL_BYTES=34359738368
# MATRIXSPOOLL_IMPORT_MAX_COMPRESSION_RATIO=200
# MATRIXSPOOLL_IMPORT_MAX_JSON_BYTES=16777216

# ============================================================
# PostgreSQL 配置
# ============================================================
# Compose 固定使用 matrixspooll 用户和 matrixspooll 数据库。
# 数据库密码（必填，docker-compose 启动时会校验）
# 仅使用字母数字，避免 URL 特殊字符（@#/?% 等）导致 DATABASE_URL 解析失败
# 生成方法: openssl rand -hex 16
POSTGRES_PASSWORD=

# docker-compose-img.yml 使用的完整应用镜像；docker-compose.yml 的源码构建不读取此项。
MATRIXSPOOLL_IMAGE=matrixspooll:production-1.2.0
# 文档站独立镜像。源码部署会由 website/Dockerfile 自动构建。
MATRIXSPOOLL_DOCS_IMAGE=matrixspooll-docs:production-1.2.0
# 使用已在服务器加载的本地镜像时保持 missing；私有镜像仓库可按需设为 always。
MATRIXSPOOLL_PULL_POLICY=missing
# 应用与源码包共同使用的交付版本号。
MATRIXSPOOLL_VERSION=1.2.0
# 仅用于 docker-compose.yml 的源码构建。默认使用 Debian 官方 HTTPS CDN；
# 中国大陆网络不稳定时可改为 https://mirrors.aliyun.com。
DEBIAN_MIRROR=https://deb.debian.org

# ============================================================
# 日志配置 (Logging)
# ============================================================
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO
